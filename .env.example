# Skopiuj do .env i uzupełnij klucz. Bez klucza aplikacja działa w trybie regułowym (bez LLM).
LLM_BASE_URL=https://api.eu.mistral.ai/v1
LLM_MODEL=ministral-3b-2512
LLM_API_KEY=

# OCR (opcjonalnie): katalog z pol.traineddata, jeśli tesseract nie ma go w domyślnym miejscu (np. macOS bez tesseract-lang).
# TESSDATA_PREFIX=/Users/ja/.local/share/tessdata
